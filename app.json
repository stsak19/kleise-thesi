          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://tfuuleuzsahipzgtbuuo.supabase.co",
      "supabaseAnonKey": "sb_publishable_BqtkyQMEECwCuqpf2JRyGA_7QUEIbFh"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "SpotOn"
    },
    "experiments": {
      "baseUrl": "/kleise-thesi"
